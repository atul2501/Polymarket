# D-S03NX: D-S03N but skips asks 0.15-0.30 (26 Oct honest replay: that band -$43, -26% on $; the rest +$108). Paper test.
[Unit]
Description=polybot D-S03NX skip 0.15-0.30 (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/d-s03nx.db TK_SKIP_MIN=0.15 TK_SKIP_MAX=0.30 TK_MATCH_DELAY=0.8 TK_QUEUE=5 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.90 TK_COOLDOWN=2 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.5 TK_MOVE_SEC=0.3 TK_SKEW=0 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
