# D-fast (Deribit signal, deploy/dfast.env) with real orders; T-fast-h12 (Binance) until 25 Oct 07:15 UTC. Starts as LIVE-DRY (signs, never posts). Go live:
#   echo TK_LIVE_DRY=0 > ~/.polybot-mode && sudo systemctl restart polybot-live
[Unit]
Description=polybot D-fast live
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
EnvironmentFile=/home/ec2-user/poly/polybot/deploy/dfast.env
EnvironmentFile=/home/ec2-user/.polybot-secrets
# Plain 12 s scalp (deploy/dfast.env); its paper twin polybot-dfast (Paper-D) was removed 26 Oct (negative on honest fills). D-HY2 (hold if bid >= 0.85) was live
# 13:57-14:45 UTC 25 Oct and reverted by the user (10 trades -$0.59; holds +$1.04, sold -$1.64); it stays on paper (polybot-dhy2).
# Small hold (user, 25 Oct ~15:20 UTC): scalp, but a position with bid >= 0.85 at 12 s is held to settlement while the
# total money in held positions stays <= $5 (one $5 hold at a time); everything else sold at 12 s.
Environment=TK_LIVE=1 TK_LIVE_DRY=1 TK_LEDGER=runs/live-d.db TK_HOLD_IF_UP=1 TK_HOLD_MIN=0.85 TK_MAX_HELD_USD=5 PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ec2-user/.polybot-mode
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10
Nice=-5

[Install]
WantedBy=multi-user.target
