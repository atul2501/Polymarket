# D-S03: Deribit 0.5 bp in 0.3 s, hold to settlement, max 20 one-sided (paper; live stays on Deribit, 25 Oct)
[Unit]
Description=polybot D-S03 (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/d-s03.db TK_MATCH_DELAY=0.8 TK_QUEUE=5 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.90 TK_COOLDOWN=2 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.5 TK_MOVE_SEC=0.3 TK_SKEW=20 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
