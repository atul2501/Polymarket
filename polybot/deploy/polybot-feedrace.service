# Price recorder (read-only, no keys), always on since 26 Oct: Deribit + 8 other BTC feeds, Chainlink BTC/USD (what the
# markets settle on), the Polymarket BTC 5m UP book and every trade print -> runs/feedrace.db (~50 MB/day).
# Feeds model research: settlesim.py, racesim.py, walletlab.py, feedrace.py report.
[Unit]
Description=polybot price recorder (feeds + Chainlink + Polymarket book)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python feedrace.py record 87600
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
