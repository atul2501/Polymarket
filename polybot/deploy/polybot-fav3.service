# D-FAV3 (paper): Deribit 0.5 bp in 3 s toward the side priced 0.45-0.95 (the favourite), hold to settlement.
# 25 Oct honest-fill replay (13.9 h): 2125 tr +$300 +3.9%/$ (most $), all thirds +, but ~$42/round, worst round -$60.
[Unit]
Description=polybot D-FAV3 favourite hold (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/fav3.db TK_MATCH_DELAY=0.8 TK_QUEUE=5 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.45 TK_MAX_ASK=0.95 TK_COOLDOWN=2 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.5 TK_MOVE_SEC=3 TK_SKEW=0 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
