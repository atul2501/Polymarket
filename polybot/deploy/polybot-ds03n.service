# D-S03N: Deribit 0.5 bp in 0.3 s, hold to settlement, NO one-sided cap, band 0.10-0.90 (racesim Deribit grid 25 Oct 2.7 h: best of 81, +10.6%/$, both halves +)
[Unit]
Description=polybot D-S03N (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/d-s03n.db TK_MATCH_FROM=runs/live-d.db TK_QUEUE=2 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.90 TK_COOLDOWN=2 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.5 TK_MOVE_SEC=0.3 TK_SKEW=0 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
