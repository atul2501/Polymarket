# Wallet clone (paper): buys the side Binance moved >= 3 bp in 3 s toward, holds to settlement like 0xc533..69a9.
[Unit]
Description=polybot W-3bp wallet clone (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/w-3bp.db TK_MOVE_BPS=3 TK_MOVE_SEC=3 TK_SETTLE=1 TK_MIN_ASK=0.15 TK_MAX_ASK=0.85 TK_COOLDOWN=2 TK_SIZE=10 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
