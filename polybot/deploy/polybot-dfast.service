# D-fast (paper): paper twin of polybot-live (same deploy/dfast.env), records the books.
[Unit]
Description=polybot D-fast Deribit signal (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
EnvironmentFile=/home/ec2-user/poly/polybot/deploy/dfast.env
# honest paper, calibrated 25 Oct on 427 live orders: order meets the book 0.8 s after the signal, 5x our shares must sit
# at the price -> same fill rate as live (36%), 81% same outcome
Environment=TK_LEDGER=runs/d-fast.db TK_MATCH_DELAY=0.8 TK_QUEUE=5 TK_QUEUE_CHEAP=5 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
