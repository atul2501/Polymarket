# DOG-AI2 (paper, shadow): W-SNIPE-DOG2's trades kept only when the frozen wallet-imitation model (dogai_model.json) says
# the copied wallet would buy there too. Lab 27 Oct, test = last 88 rounds: +23.6 %/$, thirds +28 / +10 / +27, +3.0 %
# without the best 5 rounds (W-SNIPE-DOG alone -10.7 %). Forward test: scores only signals after 27 Oct 00:55 UTC.
# Needs polybot-wsnipedog2 and polybot-feedrace running; writes runs/dogai2.db.
[Unit]
Description=polybot DOG-AI2: W-SNIPE-DOG2 filtered by the wallet-imitation model (paper, shadow)
After=polybot-wsnipedog2.service polybot-feedrace.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
Environment=PYTHONUNBUFFERED=1 DOGAI_SRC=wsnipedog2.db DOGAI_OUT=dogai2.db
ExecStart=/home/ec2-user/venv/bin/python dogai.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
