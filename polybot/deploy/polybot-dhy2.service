# D-HY2 (paper): Live-D entries; at 12 s hold to settlement only if the bid >= 0.85 and fewer than 2 held this round, else sell
[Unit]
Description=polybot D-HY2 corrected hold (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
EnvironmentFile=/home/ec2-user/poly/polybot/deploy/dfast.env
# honest paper, calibrated 25 Oct on 427 live orders: order meets the book 0.8 s after the signal, 5x our shares must sit
# at the price -> same fill rate as live (36%), 81% same outcome
Environment=TK_LEDGER=runs/d-hy2.db TK_HOLD_IF_UP=1 TK_HOLD_MIN=0.85 TK_MAX_HOLDS=2 TK_MATCH_DELAY=0.8 TK_QUEUE=5 TK_QUEUE_CHEAP=5 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
