# Wallet-style on Bybit, 0.5 bp in 3 s, max 20 one-sided shares (paper, hold to settlement, honest timing). racesim 25 Oct morning, 0.5 s delay: see racesim.py --sweep.
[Unit]
Description=polybot W-Y (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
EnvironmentFile=/home/ec2-user/poly/polybot/realistic.env
Environment=TK_LEDGER=runs/w-y.db TK_MATCH_FROM=runs/live-d.db TK_QUEUE=2 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.90 TK_COOLDOWN=2 TK_SIZE=5 BN_SOURCE=bybit BN_SOCKETS=1 TK_MOVE_BPS=0.5 TK_MOVE_SEC=3 TK_SKEW=20 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
