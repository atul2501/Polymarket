# W-CLONE-FAST (paper, SPEED REFERENCE ONLY, not reachable live): W-CLONE with fills 0.1 s after the signal and no
# run-away window, i.e. what the clone's decisions earn at the wallet's speed. W-CLONE (paper): copied-wallet clone, 26 Oct reverse engineering (29 rounds, 3,093 fills matched to ms prints):
# Deribit 0.2 bp in 0.5 s toward a side -> buy it at the ask, both sides, 0.5 s per-side cooldown, ask .10-.90, stop 30 s before the end, hold to settlement.
# Replay vs wallet: 85-88% of its buys matched, per-round corr 0.63; P/L +2.2%/$ at instant fills, 0 at 500 ms.
[Unit]
Description=polybot W-CLONE-FAST speed reference (paper)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
# realistic.env is NOT loaded: its values would override the fast timing below (EnvironmentFile wins over Environment=)
Environment=TK_LEDGER=runs/wclonefast.db TK_REAL=1 TK_CODE_DELAY=0.005 TK_RESP_DELAY=0.03 TK_SLIP=0.04 TK_MAX_SPREAD=0.03 BN_MAX_LAG_MS=300 TK_SAFE_SEC=0 TK_MATCH_DELAY=0.1 TK_QUEUE=5 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.90 TK_COOLDOWN=0.5 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.2 TK_MOVE_SEC=0.5 TK_SKEW=0 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
