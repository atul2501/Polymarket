# Dashboard on the server only (127.0.0.1). From the Mac: ssh -L 8787:localhost:8787 <server>, open localhost:8787
[Unit]
Description=polybot dashboard
After=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
Environment=DASH_BOTS=Live-D=live-d.db,Paper-D=d-fast.db,W-B=w-b.db,W-Y=w-y.db,W-B3=w-b3.db,W-Y3=w-y3.db DASH_HOURS=168 "DASH_MARK=taker start" "DASH_SINCE=2026-10-25 07:15" DASH_SIGNAL=deribit
# DASH_SINCE (server time = UTC): when live trading started; fixed so a dashboard restart never resets the totals
# optional public access: ~/.polybot-dash with DASH_HOST=0.0.0.0, DASH_USER, DASH_PASS (chmod 600; open the port
# in the security group for your own IP only)
EnvironmentFile=-/home/ec2-user/.polybot-dash
ExecStart=/home/ec2-user/venv/bin/python dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
