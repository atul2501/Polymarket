# W-SNIPE-DOG (paper): W-SNIPE but only the cheap side (ask <= 0.49). Replay 27 Oct, 440 rounds: W-SNIPE +1.2 %/$, ask < 0.50
# +10.8 %/$ (thirds +3.6 / +11.4 / +12.9, w/o best 5 rounds +1.0), ask >= 0.50 -3.0. Lumpy: profit comes from comeback rounds.
[Unit]
Description=polybot W-SNIPE-DOG: W-SNIPE on the cheap side only (paper)
After=network-online.target
Wants=network-online.target
[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/poly/polybot
# realistic.env is NOT loaded: its values would override the fast timing below (EnvironmentFile wins over Environment=)
Environment=TK_NAME=wsnipedog TK_LEDGER=runs/wsnipedog.db TK_REAL=1 TK_CODE_DELAY=0.005 TK_RESP_DELAY=0.03 TK_SLIP=0 TK_MAX_SPREAD=0.03 BN_MAX_LAG_MS=300 TK_SAFE_SEC=0 TK_MATCH_DELAY=0.25 TK_QUEUE=5 TK_QUEUE_CHEAP=5 TK_SETTLE=1 TK_MIN_ASK=0.10 TK_MAX_ASK=0.49 TK_COOLDOWN=0.5 TK_SIZE=5 BN_SOURCE=deribit BN_SOCKETS=1 TK_MOVE_BPS=0.2 TK_MOVE_SEC=0.5 TK_SKEW=0 PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/venv/bin/python taker.py
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
