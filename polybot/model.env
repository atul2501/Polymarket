# Model T-3bp: like T-fast but only on >= 3 bp moves (fewer, larger signals).
# Run: set -a; . ./model.env; set +a; python taker.py      (systemd: EnvironmentFile=.../model.env)
# Paper result 21-22 Oct (Mac, 0.3 s delay): +$78 / 143 trades, 63% won, max drawdown -$6.
TK_LEDGER=runs/t-3bp.db
TK_MOVE_BPS=3
TK_MOVE_SEC=1
TK_HOLD=5
TK_COOLDOWN=10
TK_SIZE=10
TK_MIN_ASK=0.05
TK_MAX_ASK=0.95
# set to the server's measured reaction time (region_probe.py: reaction p50, in seconds); Mac was 0.3
TK_DELAY=0.12
