# Model T-fast: Binance moves >= 2 bp in 1 s -> buy that side's ask (10 sh), sell at the bid 5 s later.
# Run: set -a; . ./model.env; set +a; python taker.py      (systemd: EnvironmentFile=.../model.env)
# Paper result 21-22 Oct (Mac, 0.3 s delay): +$235 / 387 trades, 68% won, max drawdown -$4.
TK_LEDGER=runs/t-fast.db
TK_MOVE_BPS=2
TK_MOVE_SEC=1
TK_HOLD=5
TK_COOLDOWN=10
TK_SIZE=10
TK_MIN_ASK=0.05
TK_MAX_ASK=0.95
# set to the server's measured reaction time (region_probe.py: reaction p50, in seconds); Mac was 0.3
TK_DELAY=0.12
