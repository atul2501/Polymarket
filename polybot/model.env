# Model T-0.1 LIVE: Binance >= 2 bp in 1 s -> buy that side's ask (FAK, real order), sell at the bid 5 s later.
# Starts in DRY mode (orders signed, never sent). Go live only by setting TK_LIVE_DRY=0, after the dry run looks right.
# Keys are NOT here: they go in ~/.polybot-secrets (chmod 600), see live.py.
TK_LIVE=1
TK_LIVE_DRY=1
DRY_RUN=0
TK_LEDGER=runs/live-t01.db
TK_MOVE_BPS=2
TK_MOVE_SEC=1
TK_HOLD=5
TK_COOLDOWN=10
TK_SIZE=5
TK_MIN_ASK=0.05
TK_MAX_ASK=0.95
# safety limits
TK_MAX_TRADE_USD=10
TK_MAX_DAY_LOSS=15
TK_SLIP=0.01
