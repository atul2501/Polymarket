# Model W-3bp (copied-wallet rule): Binance moves >= 3 bp in 3 s -> buy that side's ask (10 sh), hold to settlement.
# Run: set -a; . ./model.env; set +a; python taker.py      (systemd: EnvironmentFile=.../model.env)
# Paper result 21-22 Oct (Mac, 0.3 s delay): +$378 / 384 trades, 65% won, max drawdown -$64. Needs ~$250-400 balance.
TK_LEDGER=runs/w-3bp.db
TK_SETTLE=1
TK_MOVE_BPS=3
TK_MOVE_SEC=3
TK_COOLDOWN=2
TK_SIZE=10
TK_MIN_ASK=0.15
TK_MAX_ASK=0.85
# set to the server's measured reaction time (region_probe.py: reaction p50, in seconds); Mac was 0.3
TK_DELAY=0.12
