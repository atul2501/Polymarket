# Model T-0.1: T-fast rules (Binance >= 2 bp in 1 s -> buy that side's ask (10 sh), sell at the bid 5 s later)
# with a fixed 0.1 s paper delay: an optimistic "fast server" preview to compare against T-fast at the measured delay.
# Run: set -a; . ./model.env; set +a; python taker.py      (systemd: EnvironmentFile=.../model.env)
# Paper result 21-22 Oct (Mac, 0.1 s delay): +$310 / 443 trades, 72% won, max drawdown -$5.
TK_LEDGER=runs/t-0.1.db
TK_MOVE_BPS=2
TK_MOVE_SEC=1
TK_HOLD=5
TK_COOLDOWN=10
TK_SIZE=10
TK_MIN_ASK=0.05
TK_MAX_ASK=0.95
# fixed on purpose (not the server's measured reaction): this branch is the optimistic preview
TK_DELAY=0.1
