# Copy to ~/.polybot-secrets on the server, fill in, then: chmod 600 ~/.polybot-secrets
# NEVER commit the filled-in file or paste it anywhere.
PM_PRIVATE_KEY=0x...      # Polymarket: Settings -> Export private key
PM_FUNDER=0x...           # your Polymarket wallet address (the one shown on your profile / deposit page)
PM_SIGNATURE_TYPE=3       # 3 = deposit wallet (accounts since May 2026), 1 = email/Google login, 2 = MetaMask/Safe
